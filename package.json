{
  "name": "gojisim",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "GOJISIM_FREEZE=1 vitest run",
    "e2e": "pnpm --filter @gojisim/web e2e",
    "scrape": "pnpm --filter @gojisim/scraper scrape",
    "images": "pnpm --filter @gojisim/scraper images",
    "official-images": "pnpm --filter @gojisim/scraper official-images",
    "stress": "pnpm --filter @gojisim/stress stress",
    "bench": "pnpm --filter @gojisim/stress bench",
    "bots": "pnpm --filter @gojisim/bots bots",
    "bot-explain": "pnpm --filter @gojisim/bots bot-explain",
    "bot-positions": "pnpm --filter @gojisim/bots bot-positions",
    "search-rate": "pnpm --filter @gojisim/bots search-rate",
    "bot-feedback": "pnpm --filter @gojisim/bots bot-feedback",
    "feedback": "pnpm --filter @gojisim/bots feedback",
    "survey": "pnpm --filter @gojisim/ability-survey survey",
    "discord-notes": "pnpm --filter @gojisim/discord-notes discord-notes",
    "release-notes": "pnpm --filter @gojisim/release-notes release-notes",
    "slack-watch": "pnpm --filter @gojisim/slack-watch slack-watch",
    "abilities:coverage": "pnpm --filter @gojisim/ability-survey coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "railway": "3.16.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
